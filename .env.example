# Copy this file to .env, then fill in real secrets before running Docker Compose.

# Spring Boot app
APP_PORT=8080
ZHIPU_API_KEY=replace-with-your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas

# Agent-only DeepSeek chat model
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Valid names: deepseek-v4-flash (fast/cheap) or deepseek-v4-pro (stronger)
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.4
DEEPSEEK_MAX_TOKENS=2048

# Agent conversation memory
AGENT_RUN_EXECUTOR_CORE_SIZE=2
AGENT_RUN_EXECUTOR_MAX_SIZE=6
AGENT_RUN_EXECUTOR_QUEUE_CAPACITY=100
AGENT_HISTORY_SUMMARY_MAX_CHARS=3000
AGENT_HISTORY_SUMMARY_TRIGGER_MESSAGE_COUNT=6
AGENT_HISTORY_SUMMARY_TRIGGER_TOKENS=1500
AGENT_CONTEXT_MAX_TOKENS=6000
AGENT_CONTEXT_RECENT_MESSAGE_TOKENS=2200
AGENT_CONTEXT_RELEVANT_MESSAGE_TOKENS=900
AGENT_CONTEXT_RELEVANT_EXECUTION_TOKENS=1000
AGENT_CONTEXT_MEMORY_TOKENS=1000
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_MAX_ITEMS_PER_RUN=5
AGENT_MEMORY_MAX_RETRIEVED_ITEMS=6

# Per-user remote MCP connections
# Generate MCP_CREDENTIAL_KEY_V1 as 32 random bytes encoded with Base64.
# Never commit the real key. Losing it makes stored user MCP tokens unrecoverable.
MCP_CREDENTIAL_ACTIVE_KEY_ID=v1
MCP_CREDENTIAL_BACKEND=database
MCP_CREDENTIAL_KEY_V1=
MCP_USER_MAX_CONNECTIONS=10
MCP_USER_REQUEST_TIMEOUT=60s
MCP_USER_INITIALIZATION_TIMEOUT=30s
# Keep both false in production. Set true only to connect trusted local-development MCP servers.
MCP_ALLOW_PRIVATE_NETWORKS=false
MCP_ALLOW_INSECURE_HTTP=false

# ReAct Agent local tools
AGENT_REACT_MAX_STEPS=8
AGENT_REACT_WORKSPACE_ROOT=data/agent-workspace
# Optional: enables WebSearchTool. The default endpoint is Tavily-compatible.
AGENT_REACT_WEB_SEARCH_API_KEY=
AGENT_REACT_WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
AGENT_REACT_RESOURCE_MAX_BYTES=10485760
# Optional external TTF override. Blank uses bundled classpath font fonts/simhei.ttf.
# Example: C:/Windows/Fonts/simhei.ttf
AGENT_REACT_PDF_FONT_PATH=

# PostgreSQL + pgvector
POSTGRES_DB=rag_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

# Elasticsearch
ES_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# RabbitMQ
RABBITMQ_DEFAULT_USER=chathelper
RABBITMQ_DEFAULT_PASS=change-this-rabbitmq-password
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PORT=6379

# RAG retrieval tuning
RAG_VECTOR_TOPK=20
RAG_BM25_TOPK=20
RAG_FINAL_TOPK=5
RAG_FUSION_STRATEGY=rrf
RAG_FUSION_RRF_K=60
RAG_FUSION_VECTOR_WEIGHT=0.6
RAG_FUSION_BM25_WEIGHT=0.4
RAG_RERANK_ENABLED=false

# Cross-encoder rerank API (SiliconFlow / Jina / Cohere compatible /rerank contract).
# SiliconFlow: https://api.siliconflow.cn/v1  model BAAI/bge-reranker-v2-m3
# Jina:        https://api.jina.ai/v1         model jina-reranker-v2-base-multilingual
RAG_RERANK_API_ENABLED=false
RAG_RERANK_API_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_API_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_API_CANDIDATE_LIMIT=12
RAG_RERANK_API_TIMEOUT_MS=4000

# RAG exact retrieval cache
RAG_CACHE_ENABLED=false
RAG_CACHE_TTL_SECONDS=3600

# Production-friendly defaults
SPRING_JPA_SHOW_SQL=false
SPRING_THYMELEAF_CACHE=true
